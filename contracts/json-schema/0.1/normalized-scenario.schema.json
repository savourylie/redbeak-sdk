{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.redbeak.taiwaneval.com/0.1/normalized-scenario.schema.json",
  "title": "Normalized scenario 0.1",
  "x-redbeak-boundary": "internal",
  "description": "One imported scenario after deterministic normalization. It holds every user turn and the mock setup fixture, plus provenance that traces the record to raw source bytes. Evaluator-private expected evidence is stored in a sibling document, not here. This record is Redbeak-internal; a runner is only ever shown the current turn via the work-claim / next-action projection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "external_id",
    "domain",
    "turns",
    "setup",
    "involved_classes",
    "data_classification",
    "display_label",
    "provenance"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "external_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "domain": { "$ref": "common.schema.json#/$defs/slug" },
    "turns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "scenario-input.schema.json" }
    },
    "setup": {
      "description": "Mock-environment reset payload. Typed as leak_free_object so a wholesale copy of an upstream record that still carries ground_truth cannot be stored as setup.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "inline" },
        "payload": { "$ref": "common.schema.json#/$defs/leak_free_object" }
      }
    },
    "involved_classes": {
      "description": "Adapter-local mock tool-registry names from the upstream record. Not evaluation criteria. Empty for a scenario with no mock environment, such as a single-turn question answered by a plain model API.",
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "data_classification": { "$ref": "common.schema.json#/$defs/data_classification" },
    "display_label": { "type": "string", "minLength": 1, "maxLength": 100 },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_id",
        "source_revision",
        "retrieved_at",
        "license",
        "attribution",
        "raw_questions_sha256",
        "raw_possible_answers_sha256"
      ],
      "properties": {
        "source_record_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source_revision": {
          "type": "string",
          "minLength": 7,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "retrieved_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "license": { "type": "string", "minLength": 1, "maxLength": 100 },
        "attribution": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "raw_questions_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "raw_possible_answers_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    }
  }
}
