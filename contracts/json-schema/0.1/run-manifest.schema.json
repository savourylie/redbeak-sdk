{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.redbeak.taiwaneval.com/0.1/run-manifest.schema.json",
  "title": "Run manifest 0.1",
  "x-redbeak-boundary": "internal",
  "description": "The reproducibility record for one run. Every version pin required to re-derive a result lives here. This manifest is Redbeak-internal evidence and is never sent to a runner. Secrets and raw API credentials must never be serialized into it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "contract_version",
    "data_classification",
    "dataset",
    "suite",
    "target",
    "runner",
    "evaluator",
    "retry_policy",
    "repetition_index",
    "created_at"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "run_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "project_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "contract_version": { "const": "0.1" },
    "data_classification": { "$ref": "common.schema.json#/$defs/data_classification" },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "dataset_version_id", "version", "content_sha256"],
      "properties": {
        "dataset_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "dataset_version_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "version": { "$ref": "common.schema.json#/$defs/version_string" },
        "content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "source_revision": { "type": "string", "maxLength": 200 }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_id",
        "suite_version_id",
        "version",
        "case_manifest_sha256",
        "case_count",
        "domains"
      ],
      "properties": {
        "suite_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "suite_version_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "version": { "$ref": "common.schema.json#/$defs/version_string" },
        "case_manifest_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "case_count": { "type": "integer", "minimum": 1 },
        "domains": {
          "description": "The authoritative domain vocabulary for this run. JSON Schema cannot constrain a value in one document to a set declared in another, so the evaluator and dashboard check result domains against this list; recording it here at least makes the list versioned and pinned rather than absent.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/slug" }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "target_version_id", "version", "adapter_version"],
      "properties": {
        "target_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "target_version_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "version": { "$ref": "common.schema.json#/$defs/version_string" },
        "adapter_version": { "$ref": "common.schema.json#/$defs/version_string" },
        "config_fingerprint_sha256": {
          "description": "Hash of the non-secret target configuration. The configuration itself is never inlined here.",
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_version"],
      "properties": {
        "runner_version": { "$ref": "common.schema.json#/$defs/version_string" },
        "runner_id": { "$ref": "common.schema.json#/$defs/uuid" }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_version", "failure_taxonomy_version"],
      "properties": {
        "evaluator_version": { "$ref": "common.schema.json#/$defs/version_string" },
        "failure_taxonomy_version": { "$ref": "common.schema.json#/$defs/version_string" }
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "backoff_ms"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "backoff_ms": { "$ref": "common.schema.json#/$defs/duration_ms" },
        "lease_ttl_ms": { "$ref": "common.schema.json#/$defs/duration_ms" }
      }
    },
    "repetition_index": { "type": "integer", "minimum": 0, "maximum": 999 },
    "code_revision": { "type": "string", "maxLength": 200 },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "started_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "completed_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
