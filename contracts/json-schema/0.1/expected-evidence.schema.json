{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.redbeak.taiwaneval.com/0.1/expected-evidence.schema.json",
  "title": "Scenario expected evidence 0.1",
  "x-redbeak-boundary": "internal",
  "description": "Evaluator-private expected evidence for one imported scenario. Derived from upstream possible-answer and tool-path fields, stored separately from runner-visible scenario data. Never sent to a runner, an adapter, or a work-claim payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "external_id",
    "data_classification",
    "display_label",
    "expected_evidence",
    "provenance"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "external_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "data_classification": { "$ref": "common.schema.json#/$defs/data_classification" },
    "display_label": { "type": "string", "minLength": 1, "maxLength": 100 },
    "expected_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_path", "per_turn_calls"],
      "properties": {
        "tool_path": {
          "description": "Upstream evaluator-private tool-path metadata, renamed so it cannot be confused with a file-system mock `path` key.",
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "per_turn_calls": {
          "description": "Upstream possible-answer call lists, one list per user turn, kept for the evaluator. Not a runner payload.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "items": { "type": "string", "minLength": 1, "maxLength": 8000 }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_id",
        "source_revision",
        "raw_questions_sha256",
        "raw_possible_answers_sha256"
      ],
      "properties": {
        "source_record_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source_revision": {
          "type": "string",
          "minLength": 7,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "raw_questions_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "raw_possible_answers_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    }
  }
}
