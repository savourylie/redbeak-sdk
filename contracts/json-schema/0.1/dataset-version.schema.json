{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.redbeak.taiwaneval.com/0.1/dataset-version.schema.json",
  "title": "Dataset version 0.1",
  "x-redbeak-boundary": "internal",
  "description": "An immutable imported dataset version: pinned source provenance, content hash, and the artifacts produced by a deterministic import. This record is Redbeak-internal evidence and is never sent to a runner. Secrets and raw API credentials must never be serialized into it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version_id",
    "dataset_slug",
    "version",
    "content_sha256",
    "record_count",
    "domains",
    "data_classification",
    "display_label",
    "source",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "dataset_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "dataset_version_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "dataset_slug": { "$ref": "common.schema.json#/$defs/slug" },
    "version": { "$ref": "common.schema.json#/$defs/version_string" },
    "content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "record_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/slug" }
    },
    "data_classification": { "$ref": "common.schema.json#/$defs/data_classification" },
    "display_label": {
      "description": "Operator-facing origin label. Demo v0 values are always Synthetic / BFCL-derived.",
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "source": { "$ref": "#/$defs/source" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "artifact-manifest.schema.json" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "release_tag",
        "resolved_revision",
        "retrieved_at",
        "license",
        "attribution",
        "urls",
        "files"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "release_tag": { "type": "string", "minLength": 1, "maxLength": 64 },
        "resolved_revision": {
          "type": "string",
          "minLength": 7,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "retrieved_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "license": { "type": "string", "minLength": 1, "maxLength": 100 },
        "attribution": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "urls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["questions", "possible_answers", "release"],
          "properties": {
            "questions": { "type": "string", "minLength": 1, "maxLength": 500 },
            "possible_answers": { "type": "string", "minLength": 1, "maxLength": 500 },
            "release": { "type": "string", "minLength": 1, "maxLength": 500 },
            "license": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/source_file" }
        }
      }
    },
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "relative_path", "sha256", "size_bytes"],
      "properties": {
        "role": { "enum": ["questions", "possible_answers", "license"] },
        "relative_path": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "source_url": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
